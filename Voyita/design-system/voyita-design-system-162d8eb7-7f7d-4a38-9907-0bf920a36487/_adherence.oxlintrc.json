{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/glyphs/**",
              "components/icons/**",
              "components/navigation/**",
              "ui_kits/traveler_portal/**",
              "ui_kits/voyita_admin/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Sora|Inter))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Sora, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionIcons'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|size|key|ref|className|style|children)$/]",
        "message": "<ActionIcons> doesn't accept that prop. Declared props: active, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|key|ref|className|style|children)$/]",
        "message": "<AIButton> doesn't accept that prop. Declared props: children, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<AIButton> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:actionLabel|actionIcon|onAction|user|showLogo|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: actionLabel, actionIcon, onAction, user, showLogo."
      },
